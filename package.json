{
  "description": "个人收藏网站（Vue 3 重写版）：导航收藏夹，支持分类管理、私密链接暗号查看、今日热门榜",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "name": "nav-vue",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "lint:client": "npm run lint --workspace=client",
    "migrate": "npm run migrate --workspace=server",
    "start": "npm run start --workspace=server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "version": "0.3.0",
  "workspaces": [
    "client",
    "server"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
