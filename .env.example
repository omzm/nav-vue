# 复制为 .env 后填入真实值。生产环境用环境变量注入，不要提交 .env。
# 从 nav（Next.js 版）迁移过来时，NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# 可直接沿用（服务端同时兼容新旧变量名）。

# Supabase 项目地址
SUPABASE_URL=
# Supabase anon key（公开读：首页快照、开门口令校验）
SUPABASE_ANON_KEY=
# Supabase service_role key（只放服务端，绝不暴露给浏览器）
SUPABASE_SERVICE_ROLE_KEY=
# 数据库直连（仅迁移脚本用）
DATABASE_URL=

# 管理员会话签名密钥：随机长字符串，签发后台登录 Cookie 用
ADMIN_SESSION_SECRET=
# 初始化口令：生产环境必填，/admin/setup 向导需要输入
SETUP_TOKEN=
# 访客"提交收录"的密码；不填则首页不显示提交入口
SUBMIT_PASSWORD=

# 监听端口（默认 3001）
PORT=3001
# 生产环境设为 production（Cookie 自动 Secure + 托管前端构建产物）
NODE_ENV=development
# 迁移脚本环境：production 才真正执行；preview/staging 跳过；不填=本地手动跑
MIGRATE_ENV=
